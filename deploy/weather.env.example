# RPi4: /etc/hestia/weather.env 로 복사해 값을 채운다 (sudo chmod 600). 이 예시 파일에는 키를 넣지 않는다.

# 공공데이터포털 인증키 — "기상청_단기예보 조회서비스", "기상청_기상특보 조회서비스" 둘 다 활용 신청 (Decoding 키 권장, Encoding 키도 됨)
KMA_SERVICE_KEY=

# 브로커는 RPi5 에 있다
MQTT_HOST=rpi5.local
MQTT_PORT=1883

# homes/<HESTIA_HOME>.toml 의 [location] 을 읽는다
HESTIA_CONFIG=/data/hestia/config
HESTIA_HOME=demo
